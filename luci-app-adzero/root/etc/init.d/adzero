#!/bin/sh /etc/rc.common
START=98
STOP=09
USE_PROCD=1
start_service() {
	[ "$(uci -q get adzero.main.enabled)" = 1 ] || return 0
	if [ -f /etc/adzero/dns-pool-needed ] || [ "$(uci -q get adzero.main.dns_profile | jsonfilter -e '@.strict' 2>/dev/null)" = true ]; then
		/etc/init.d/adzero-dns enable && /etc/init.d/adzero-dns start || return 1
	fi
	if [ "$(uci -q get adzero.main.dns_profile | jsonfilter -e '@.strict' 2>/dev/null)" = true ]; then
		/usr/libexec/adzero/dns-guard ensure || return 1
		procd_open_instance dns_guard
		procd_set_param command /usr/libexec/adzero/dns-guard watch
		procd_set_param respawn 3600 2 5
		procd_set_param term_timeout 3
		procd_set_param stderr 1
		procd_close_instance
	fi
	procd_open_instance
	procd_set_param command /usr/libexec/adzero/watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
	# Optional features consume no extra workers until explicitly enabled.
	local enhance
	enhance=$(uci -q get adzero.main.dns_enhance)
	if [ "$(printf '%s' "$enhance" | jsonfilter -e '@.enabled' 2>/dev/null)" = true ]; then
		procd_open_instance dns_enhance
		procd_set_param command /usr/libexec/adzero/dns-enhance run
		procd_set_param respawn 3600 5 5
		procd_set_param term_timeout 5
		procd_set_param stderr 1
		procd_close_instance
	fi
	if [ "$(printf '%s' "$enhance" | jsonfilter -e '@.failover' 2>/dev/null)" = true ]; then
		procd_open_instance dns_monitor
		procd_set_param command /usr/libexec/adzero/dns-enhance monitor
		procd_set_param respawn 3600 10 5
		procd_set_param term_timeout 3
		procd_set_param stderr 0
		procd_close_instance
	fi
	# DNS NAT handoff must not wait for a lengthy rule/adapter reconciliation.
	procd_open_instance dns_handoff
	procd_set_param command /usr/libexec/adzero/dns-handoff run
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param term_timeout 3
	procd_close_instance
	# A separate read-only observer never holds ctl's operation lock.
	procd_open_instance observe
	procd_set_param command /usr/libexec/adzero/observe run
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param term_timeout 3
	procd_close_instance
}
stop_service() {
	# Remove only the table carrying our ownership comment, before stopping DNS.
	/usr/libexec/adzero/dns-enhance cleanup >/dev/null 2>&1 || :
}
service_triggers() {
	procd_add_reload_trigger adzero
}
