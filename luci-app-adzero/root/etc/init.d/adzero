#!/bin/sh /etc/rc.common
START=98
STOP=09
USE_PROCD=1
start_service() {
	[ "$(uci -q get adzero.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/adzero/watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
	# DNS NAT handoff must not wait for a lengthy rule/adapter reconciliation.
	procd_open_instance dns_handoff
	procd_set_param command /usr/libexec/adzero/dns-handoff run
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param term_timeout 3
	procd_close_instance
	# A separate read-only observer never holds ctl's operation lock.
	procd_open_instance observe
	procd_set_param command /usr/libexec/adzero/observe run
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param term_timeout 3
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger adzero
}
