#!/bin/sh /etc/rc.common
START=21
STOP=09
USE_PROCD=1
start_service() {
	[ "$(uci -q get adzero.main.enabled)" = 1 ] || return 0
	local base="${ADZERO_DNS_INIT_ROOT:-}"
	if [ "$(uci -q get adzero.main.dns_profile | jsonfilter -e '@.strict' 2>/dev/null)" = true ]; then
		"$base/usr/libexec/adzero/dns-guard" boot-ensure || return 1
	fi
	[ "$(uci -q get adzero.main.routing_enabled)" = 1 ] || return 0
	[ -f "$base/etc/adzero/dns-pool-needed" ] && [ ! -L "$base/etc/adzero/dns-pool-needed" ] || return 0
	[ "$(cat "$base/etc/adzero/dns-pool-needed")" = 'AdZero DNS pool v1' ] || return 1
	procd_open_instance
	procd_set_param command ucode -S /usr/libexec/adzero/dns-pool.uc
	procd_set_param respawn 3600 2 5
	procd_set_param term_timeout 3
	procd_set_param stderr 1
	procd_close_instance
}
