{
  "luci-app-adzero": {
    "description": "AdZero status and limited service actions",
    "read": {
      "file": {
        "/usr/libexec/adzero/ctl status": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "exec"
        ],
        "adzero": [
          "lookup",
          "source_list",
          "job_status"
        ]
      },
      "uci": [
        "adzero"
      ]
    },
    "write": {
      "file": {},
      "ubus": {
        "adzero": [
          "enable",
          "disable",
          "refresh",
          "reload",
          "routing_on",
          "routing_off",
          "allow",
          "revoke",
          "pause",
          "resume",
          "source_add",
          "source_toggle",
          "source_remove",
          "source_refresh",
          "source_verify",
          "settings_apply"
        ]
      },
      "uci": [
        "adzero"
      ]
    }
  }
}
