#!/bin/sh
# Manage adblock-fast plus owned native proxy DNS extension points.

# Default-deny behavior: never silently intercept DNS or change proxy routing.
umask 077
set -f
UCI_BIN=$ADZERO_UCI
BACKEND_INIT=$ADZERO_BACKEND_INIT
STATE_DIR=$ADZERO_STATE_DIR
LOCK_DIR=$ADZERO_LOCK_DIR
NAILINK_CONFIG=$ADZERO_NAILINK_CONFIG
PIDOF_BIN=$ADZERO_PIDOF
DAED_CONFIG=$ADZERO_DAED_CONFIG
DAED_VERSION=$ADZERO_DAED_VERSION
DAED_CHECK=$ADZERO_DAED_CHECK
[ -n "$DAED_CONFIG" ] || DAED_CONFIG=/etc/config/daed
[ -n "$DAED_VERSION" ] || DAED_VERSION=/usr/share/daed-router/version
[ -n "$DAED_CHECK" ] || DAED_CHECK=/usr/libexec/daed/check

[ -n "$UCI_BIN" ] || UCI_BIN=uci
[ -n "$BACKEND_INIT" ] || BACKEND_INIT=/etc/init.d/adblock-fast
[ -n "$STATE_DIR" ] || STATE_DIR=/etc/adzero
[ -n "$LOCK_DIR" ] || LOCK_DIR=/tmp/adzero.lock
[ -n "$NAILINK_CONFIG" ] || NAILINK_CONFIG=/etc/config/nailink
[ -n "$PIDOF_BIN" ] || PIDOF_BIN=pidof
MANAGED_MARKER=$STATE_DIR/managed
FORCE_BACKUP=$STATE_DIR/force_dns.previous
TLS_BACKUP=$STATE_DIR/download_allow_insecure.previous
PROBE=${ADZERO_PROBE:-$(dirname "$0")/probe}
RULES_LIBRARY=${ADZERO_RULES_LIBRARY:-$(dirname "$0")/rules.sh}
ADAPTER=${ADZERO_ADAPTER:-$(dirname "$0")/adapter}
LOCK_PROGRAM=${ADZERO_LOCK_PROGRAM:-$(dirname "$0")/lock}
OBSERVE=${ADZERO_OBSERVE:-$(dirname "$0")/observe}
BACKEND_CHECK=${ADZERO_BACKEND_CHECK:-$(dirname "$0")/backend}
POLICY=${ADZERO_POLICY:-$(dirname "$0")/policy}
SOURCES=${ADZERO_SOURCES:-$(dirname "$0")/sources}
[ -r "$RULES_LIBRARY" ] || { echo 'AdZero: missing rules library' >&2; exit 1; }
. "$RULES_LIBRARY"

error() {
	printf 'AdZero: %s\n' "$*" >&2
	exit 1
}
progress() {
	[ -n "$ADZERO_JOB_CONTEXT" ] && [ -d "$ADZERO_JOB_CONTEXT" ] || return 0
	case "$1" in waiting_lock|checking|processing|adapting|restoring|verifying) ;; *) return 0 ;; esac
	[ ! -L "$ADZERO_JOB_CONTEXT/stage" ] && [ ! -L "$ADZERO_JOB_CONTEXT/stage.new" ] || return 0
	previous_stage=; [ ! -f "$ADZERO_JOB_CONTEXT/stage" ] || read -r previous_stage < "$ADZERO_JOB_CONTEXT/stage"
	[ "$previous_stage" != "$1" ] || return 0
	stage_now=$(date +%s)
	[ -L "$ADZERO_JOB_CONTEXT/stage_started" ] || printf '%s\n' "$stage_now" > "$ADZERO_JOB_CONTEXT/stage_started"
	printf '%s\n' "$1" > "$ADZERO_JOB_CONTEXT/stage.new" && mv "$ADZERO_JOB_CONTEXT/stage.new" "$ADZERO_JOB_CONTEXT/stage" || :
	[ -L "$ADZERO_JOB_CONTEXT/timeline" ] || printf '%s %s\n' "$stage_now" "$1" >> "$ADZERO_JOB_CONTEXT/timeline"
}
public_failure() {
	[ -n "$ADZERO_JOB_CONTEXT" ] && [ -d "$ADZERO_JOB_CONTEXT" ] || return 0
	[ ! -e "$ADZERO_JOB_CONTEXT/reason" ] || return 0
	case "$1" in lock_busy|backend|source_limit|source_download|backend_memory|backend_dns|backend_processing|backend_files) printf '%s' "$1" > "$ADZERO_JOB_CONTEXT/reason" ;; esac
}
public_recovery() {
	[ -n "$ADZERO_JOB_CONTEXT" ] && [ -d "$ADZERO_JOB_CONTEXT" ] || return 0
	case "$(cat "$ADZERO_JOB_CONTEXT/reason" 2>/dev/null)" in dns_pool_*) ;; *) return 0 ;; esac
	case "$1" in restored|unconfirmed) ;; *) return 0 ;; esac
	[ ! -L "$ADZERO_JOB_CONTEXT/recovery" ] && [ ! -L "$ADZERO_JOB_CONTEXT/recovery.new" ] || return 0
	printf '%s' "$1" > "$ADZERO_JOB_CONTEXT/recovery.new" && mv "$ADZERO_JOB_CONTEXT/recovery.new" "$ADZERO_JOB_CONTEXT/recovery" || :
}
backend_failure() {
	# Only a fixed token from the read-only checker, never raw service errors.
	backend_hint=$("$BACKEND_CHECK" failure 2>/dev/null) || backend_hint=backend
	case "$backend_hint" in source_limit|source_download|backend_memory|backend_dns|backend_processing|backend_files) ;; *) backend_hint=backend ;; esac
	public_failure "$backend_hint"
}
get_uci() {
	"$UCI_BIN" -q get "$1" 2>/dev/null || :
}
write_uci() {
	"$UCI_BIN" set "$1=$2" && "$UCI_BIN" commit "$3"
}
delete_uci() {
	"$UCI_BIN" -q delete "$1" && "$UCI_BIN" commit "$2"
}
force_dns_state() {
	setting=$(get_uci adblock-fast.config.force_dns)
	case "$setting" in
		0) printf 'off\n' ;;
		1) printf 'on\n' ;;
		'') printf 'default_on\n' ;;
		*) printf 'unknown\n' ;;
	esac
}
tls_download_state() {
	setting=$(get_uci adblock-fast.config.download_allow_insecure)
	case "$setting" in
		0) printf 'strict\n' ;;
		1) printf 'insecure\n' ;;
		'') printf 'default_insecure\n' ;;
		*) printf 'unknown\n' ;;
	esac
}
# Firewall-influencing nftset/ipset resolver modes are intentionally excluded.
resolver_is_safe() {
	case "$(resolver_mode)" in
		dnsmasq.servers|dnsmasq.addnhosts|smartdns.domainset|unbound.adb_list) return 0 ;;
		*) return 1 ;;
	esac
}
dnsmasq_port_hint() {
	port=$(get_uci 'dhcp.@dnsmasq[0].port')
	case "$port" in
		''|53) printf 'default\n' ;;
		0) printf 'disabled\n' ;;
		*) printf 'nonstandard\n' ;;
	esac
}
backend_available() {
	[ -x "$BACKEND_INIT" ] && [ -x "$BACKEND_CHECK" ] && command -v "$UCI_BIN" >/dev/null 2>&1
}
backend_confirm() {
	progress verifying
	# Resolver restarts may be acknowledged by procd before the process is up.
	attempt=0
	backend_result=
	while [ "$attempt" -lt 5 ]; do
		backend_result=$("$BACKEND_CHECK" "$1" 2>/dev/null) && return 0
		attempt=$((attempt + 1))
		[ "$attempt" -ge 5 ] || sleep 1
	done
	printf 'AdZero: 后端状态检查未通过（%s）：%s\n' "$1" "${backend_result:-unavailable}" >&2
	return 1
}
backend_stop() {
	# adblock-fast's service_stopped hook returns 1 when no fw4 restart is
	# needed. Accept that code only with independently confirmed stopped state.
	backend_rc=0
	"$BACKEND_INIT" stop || backend_rc=$?
	case "$backend_rc" in 0|1) backend_confirm stopped ;; *) return 1 ;; esac
}
backend_restart() {
	progress processing
	# Clear and confirm old state first: an old statusSuccess and rule file
	# must not disguise an invocation that failed before producing new state.
	backend_stop || { backend_failure; return 1; }
	[ "$(get_uci adblock-fast.config.enabled)" = 1 ] || return 0
	progress processing
	backend_rc=0
	# Reuse individually verified HTTPS snapshots, only in this backend child.
	# Unsupported/custom curl invocations transparently retain real curl.
	PATH="$(dirname "$SOURCES")/cache-curl:$PATH" ADZERO_SOURCE_REPLAY=1 \
		"$BACKEND_INIT" "${1:-start}" || backend_rc=$?
	case "$backend_rc" in 0|1) backend_confirm ready || { backend_failure; return 1; } ;; *) backend_failure; return 1 ;; esac
	# Optional optimization only. Missing/corrupt proof falls back to download.
	if [ "${1:-start}" = start ]; then "$SOURCES" cache-save preserve >/dev/null 2>&1 || :
	else "$SOURCES" cache-save >/dev/null 2>&1 || :; fi
}
reload_current() {
	if adapter_reload_pending; then finish_pending_reload; printf 'confirmed previous proxy reload\n'; return 0; fi
	require_active
	reject_insecure_custom_fetch_flags
	policy_clean || error '存在未完成恢复记录，请先关闭并恢复。'
	# No network refresh when the current output is still proven to match
	# the selected configuration. Adapter.apply independently checks its input.
	if ! "$SOURCES" cache-current >/dev/null 2>&1 && ! "$SOURCES" cache-live >/dev/null 2>&1; then
		# Check the candidate while the working resolver is still running.
		"$SOURCES" preflight || error '容量预检未完成，未执行重新加载。'
		backend_restart dl || error '重新加载后端失败，恢复记录已保留。'
	fi
	ADZERO_ADAPTER_REFRESH=1 "$ADAPTER" apply || error '重新加载代理接入未完成，恢复记录已保留。'
	printf 'reloaded current configuration\n'
}
backend_rebuild_if_changed() {
	# Live output, effective options and verified rule content must match.
	# Metadata, identical bytes and equivalent domain rules need no rebuild.
	if "$SOURCES" cache-restamp >/dev/null 2>&1; then return 0; fi
	if "$SOURCES" cache-live >/dev/null 2>&1; then
		# Keep restore metadata current too, so skipping an unchanged refresh
		# does not defer a needless rebuild to the next disable/enable cycle.
		"$SOURCES" cache-save >/dev/null 2>&1 || :
		return 0
	fi
	backend_restart dl
}
adguardhome_running() {
	command -v "$PIDOF_BIN" >/dev/null 2>&1 && "$PIDOF_BIN" AdGuardHome >/dev/null 2>&1
}
nailink_installed() {
	[ -e "$NAILINK_CONFIG" ] || [ -r "$DAED_VERSION" ] || \
		{ [ -e "$DAED_CONFIG" ] && [ -x "$DAED_CHECK" ]; }
}
nailink_running() {
	nailink_installed && command -v "$PIDOF_BIN" >/dev/null 2>&1 && \
		"$PIDOF_BIN" daed >/dev/null 2>&1
}
resolver_mode() {
	mode=$(get_uci adblock-fast.config.dns)
	case "$mode" in
		dnsmasq.servers|dnsmasq.conf|dnsmasq.addnhosts|dnsmasq.ipset|dnsmasq.nftset|smartdns.domainset|smartdns.ipset|smartdns.nftset|unbound.adb_list)
			printf '%s\n' "$mode" ;;
		*)
			printf '%s\n' unknown ;;
	esac
}
policy_clean() {
	policy_rc=0; "$POLICY" pending >/dev/null 2>&1 || policy_rc=$?
	[ "$policy_rc" = 1 ] && "$POLICY" validate >/dev/null 2>&1 && sources_clean
}
sources_clean() {
	sources_rc=0; "$SOURCES" pending >/dev/null 2>&1 || sources_rc=$?
	[ "$sources_rc" = 1 ]
}
adapter_reload_pending() {
	[ "$("$ADAPTER" pending 2>/dev/null)" = nailink ]
}
retain_pending_reload() {
	if adapter_reload_pending; then
		public_failure nailink_gateway
		error '代理重载尚未确认；保留本批规则和后端，后台将继续核对，不提交第二次重载。'
	fi
}
finish_pending_reload() {
	# Completion is tied to a native version barrier, exact profiles, owned
	# files, backend input and dataplane readiness; running=true is insufficient.
	"$SOURCES" confirm && "$POLICY" confirm && "$ADAPTER" settle || error '代理重载尚未确认，恢复记录已保留。'
	if ! sources_clean; then "$SOURCES" finish || error '已确认重载，但规则完成记录未能清理。'; fi
	"$POLICY" finish && "$POLICY" routing-finish || error '已确认重载，但策略完成记录未能清理。'
}
json_bool() {
	if [ "$1" = 1 ]; then printf true; else printf false; fi
}
process_start() (
	case "$1" in ''|*[!0-9]*) exit 1 ;; esac
	# comm may contain spaces or ')'. Fields after its final ')' start at 3.
	{ IFS= read -r stat_line < "/proc/$1/stat"; } 2>/dev/null || exit 1
	stat_fields=${stat_line##*) }
	set -- $stat_fields
	[ "$#" -ge 20 ] || exit 1
	case "$1" in Z|X|x) exit 1 ;; esac
	shift 19
	case "$1" in ''|*[!0-9]*) exit 1 ;; esac
	printf '%s\n' "$1"
)
operation_status() (
	# Presentation only: never reclaim locks or expose PIDs / private argv.
	[ -d "$LOCK_DIR" ] || { printf '{"active":false,"locked":false}'; exit; }
	inactive='{"active":false,"locked":true}'
	[ ! -L "$LOCK_DIR" ] && [ ! -L "$LOCK_DIR/owner" ] && [ ! -L "$LOCK_DIR/identity" ] || { printf '%s' "$inactive"; exit; }
	{ IFS= read -r record < "$LOCK_DIR/owner"; } 2>/dev/null || { printf '%s' "$inactive"; exit; }
	set -- $record
	[ "$#" = 2 ] || { printf '%s' "$inactive"; exit; }
	pid=$1; action=$2
	case "$action" in reconcile|enable|disable|refresh|reload|lookup|allow|revoke|temporary|temporary-expire|pause|resume|routing-on|routing-off|source-add|source-toggle|source-remove|source-refresh|source-verify|settings-apply|controls-apply|enhance-save|dns-switch) ;; *) printf '%s' "$inactive"; exit ;; esac
	start=$(process_start "$pid") || { printf '%s' "$inactive"; exit; }
	{ IFS= read -r identity < "$LOCK_DIR/identity"; } 2>/dev/null || { printf '%s' "$inactive"; exit; }
	[ "$identity" = "$record $start" ] || { printf '%s' "$inactive"; exit; }
	# A completed operation can release the directory during this read.
	{ IFS= read -r current < "$LOCK_DIR/owner"; } 2>/dev/null || { printf '{"active":false,"locked":false}'; exit; }
	[ "$record" = "$current" ] && [ "$(process_start "$pid")" = "$start" ] || { printf '%s' "$inactive"; exit; }
	printf '{"active":true,"locked":true,"action":"%s"}' "$action"
)
print_status() {
	configured=$(get_uci adzero.main.enabled)
	actual=$(get_uci adblock-fast.config.enabled)
	owner=0; nailink=0; nailink_active=0; nailink_enabled=0; agh=0; safe_mode=0
	[ -f "$MANAGED_MARKER" ] && owner=1
	nailink_installed && nailink=1
	nailink_running && nailink_active=1
	[ "$nailink" = 1 ] && [ "$(get_uci daed.main.enabled)" = 1 ] && nailink_enabled=1
	adguardhome_running && agh=1
	resolver_is_safe && safe_mode=1
	force_status=$(force_dns_state)
	tls_status=$(tls_download_state)
	port_hint=$(dnsmasq_port_hint)
	rule_sources=$(rule_sources_state)

	if ! backend_available; then
		state=unavailable
	elif [ "$actual" = 1 ] && [ "$owner" = 0 ]; then
		state=external_owner
	elif [ "$configured" = 1 ] && [ "$owner" = 1 ] && [ "$actual" = 1 ] && \
		 [ "$force_status" = off ] && [ "$tls_status" = strict ] && \
		 [ -f "$FORCE_BACKUP" ] && [ -f "$TLS_BACKUP" ]; then
		state=configured_unverified
	elif [ "$configured" = 0 ] && [ "$actual" = 0 ] && [ "$owner" = 0 ] && \
		 [ ! -e "$FORCE_BACKUP" ] && [ ! -e "$TLS_BACKUP" ]; then
		state=disabled
	else
		state=inconsistent
	fi
	if [ "$state" = configured_unverified ] && [ "$rule_sources" != configured ]; then state=inconsistent; fi

	dns_review=0
	[ "$nailink" = 1 ] && dns_review=1
	[ "$agh" = 1 ] && dns_review=1
	[ "$safe_mode" = 0 ] && dns_review=1
	case "$(resolver_mode)" in
		dnsmasq.*) [ "$port_hint" = default ] || dns_review=1 ;;
	esac

	# Fields are strictly enumerated; no private upstream DNS addresses.
	compatibility=$(sh "$PROBE" 2>/dev/null) || compatibility=null
	[ -n "$compatibility" ] || compatibility=null
	adapter_status=$("$ADAPTER" status 2>/dev/null) || adapter_status=null
	[ -n "$adapter_status" ] || adapter_status=null
	backend_ready=0
	# Display uses live service metadata and output existence. Full rule
	# validation remains in backend_confirm/require_active for every mutation.
	backend_status=$("$BACKEND_CHECK" inspect 2>/dev/null) && backend_ready=1
	[ -n "$backend_status" ] || backend_status=null
	if [ "$state" = configured_unverified ]; then
		case "$adapter_status" in null|*recovery_required*|*preparing*|*restarting*|*restoring*) state=inconsistent ;; esac
		if [ "$(printf '%s' "$adapter_status" | jsonfilter -e '@.dns_policy.strict' 2>/dev/null)" = true ] && \
		   [ "$(printf '%s' "$adapter_status" | jsonfilter -e '@.dns_policy.guard' 2>/dev/null)" != active ]; then state=inconsistent; fi
		[ "$backend_ready" = 1 ] || state=inconsistent
	fi
	policy_status=$("$POLICY" status 2>/dev/null) || policy_status=null
	if [ -f "$STATE_DIR/pause.json" ]; then
		state=inconsistent
		if [ "$owner" = 1 ] && [ "$configured" = 1 ] && [ "$actual" = 0 ] && \
		   [ "$force_status" = off ] && [ "$tls_status" = strict ] && [ -f "$FORCE_BACKUP" ] && [ -f "$TLS_BACKUP" ] && \
		   "$POLICY" is-paused && "$BACKEND_CHECK" stopped >/dev/null 2>&1; then
			case "$adapter_status" in *'"stage": "inactive"'*|*'"stage":"inactive"'*) state=paused ;; esac
		fi
	fi
	policy_clean || state=inconsistent
	[ "$policy_status" != null ] || state=inconsistent
	observation_status=null; client_verified=false
	if [ "$STATE_DIR" = /etc/adzero ] && [ -x "$OBSERVE" ]; then
		observation_status=$("$OBSERVE" status 2>/dev/null) || observation_status=null
		[ -n "$observation_status" ] || observation_status=null
		if [ "$state" = configured_unverified ] && [ "$(printf '%s' "$observation_status" | jsonfilter -e '@.client_dns_verified' 2>/dev/null)" = true ]; then client_verified=true; fi
	fi
	handoff_status=null
	if [ "$STATE_DIR" = /etc/adzero ] && [ -x "$(dirname "$0")/dns-handoff" ]; then
		handoff_status=$("$(dirname "$0")/dns-handoff" status 2>/dev/null) || handoff_status=null
		[ -n "$handoff_status" ] || handoff_status=null
	fi
	printf '{"state":"%s","managed":%s,"configured":%s,"backend_enabled":%s,"resolver":"%s","nailink_detected":%s,"nailink_running":%s,"nailink_enabled":%s,"adguardhome_running":%s,"dns_mode_safe":%s,"dns_review_needed":%s,"dnsmasq_port_hint":"%s","force_dns":"%s","tls_download":"%s","client_dns_verified":%s,"rule_sources":"%s","compatibility":%s,"adapter":%s,"backend":%s,"policy":%s,"observation":%s,"operation":%s,"dns_handoff":%s}\n' \
		"$state" "$(json_bool "$owner")" "$(json_bool "$configured")" \
		"$(json_bool "$actual")" "$(resolver_mode)" "$(json_bool "$nailink")" \
		"$(json_bool "$nailink_active")" "$(json_bool "$nailink_enabled")" \
		"$(json_bool "$agh")" "$(json_bool "$safe_mode")" "$(json_bool "$dns_review")" \
		"$port_hint" "$force_status" "$tls_status" "$client_verified" "$rule_sources" "$compatibility" "$adapter_status" "$backend_status" "$policy_status" "$observation_status" "$(operation_status)" "$handoff_status"
}
release_lock() {
	# Never remove a lock whose owner record was replaced by another operation.
	lock_record=
	[ -f "$LOCK_DIR/owner" ] && read -r lock_record < "$LOCK_DIR/owner"
	[ "$lock_record" = "$lock_identity" ] || return 0
	rm -f "$LOCK_DIR/identity" "$LOCK_DIR/owner" "$LOCK_DIR/lease" && rmdir "$LOCK_DIR" 2>/dev/null || :
}
retire_stale_lock() (
	# Called only while descriptor 9 holds the kernel lease. A killed ctl's
	# descendants inherit that lease, so an orphan still writing cannot be stolen.
	[ ! -L "$LOCK_DIR" ] && [ -d "$LOCK_DIR" ] || exit 1
	[ ! -L "$LOCK_DIR/lease" ] && [ -f "$LOCK_DIR/lease" ] || exit 1
	[ "$(cat "$LOCK_DIR/lease")" = 'AdZero kernel lease v1' ] || exit 1
	set +f
	for entry in "$LOCK_DIR"/* "$LOCK_DIR"/.[!.]* "$LOCK_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		case "$entry" in "$LOCK_DIR/lease"|"$LOCK_DIR/owner"|"$LOCK_DIR/identity") ;; *) exit 1 ;; esac
		[ -f "$entry" ] && [ ! -L "$entry" ] || exit 1
	done
	owner=; [ ! -f "$LOCK_DIR/owner" ] || read -r owner < "$LOCK_DIR/owner"
	set -- $owner
	if [ "$#" -gt 0 ]; then
		case "$1" in ''|*[!0-9]*) exit 1 ;; esac
		# Also protect a live owner if its lease file was replaced externally.
		live_start=$(process_start "$1")
		if [ -n "$live_start" ]; then
			identity=; read -r identity < "$LOCK_DIR/identity" || exit 1
			[ "$identity" != "$owner $live_start" ] || exit 1
			old_start=${identity#"$owner "}
			case "$old_start" in ''|*[!0-9]*) exit 1 ;; esac
		fi
	fi
	rm -f "$LOCK_DIR/identity" "$LOCK_DIR/owner" "$LOCK_DIR/lease" && rmdir "$LOCK_DIR"
)
acquire_lock() {
	progress waiting_lock
	lock_action=$1
	default_wait=30; maximum_wait=60
	[ "$lock_action" != disable ] || { default_wait=300; maximum_wait=300; }
	lock_wait=${ADZERO_LOCK_WAIT_SECONDS:-$default_wait}
	case "$lock_wait" in ''|*[!0-9]*) error '操作锁等待时间无效。' ;; esac
	[ "$lock_wait" -le "$maximum_wait" ] 2>/dev/null || error '操作锁等待时间超出允许范围。'
	lock_elapsed=0
	[ -d "$(dirname "$LOCK_DIR")" ] || error '无法创建操作锁，请检查临时目录。'
	[ ! -L "$LOCK_DIR.lease" ] && { [ ! -e "$LOCK_DIR.lease" ] || [ -f "$LOCK_DIR.lease" ]; } || error '操作租约文件无效。'
	exec 9>>"$LOCK_DIR.lease" || error '无法创建操作锁，请检查临时目录。'
	while :; do
		if "$LOCK_PROGRAM"; then
			if mkdir "$LOCK_DIR" 2>/dev/null; then break; fi
			if retire_stale_lock && mkdir "$LOCK_DIR" 2>/dev/null; then break; fi
		fi
		[ ! -L "$LOCK_DIR" ] && { [ ! -e "$LOCK_DIR" ] || [ -d "$LOCK_DIR" ]; } || error '无法创建操作锁，请检查临时目录。'
		# A scheduled sync is optional; don't compete with a user's operation.
		[ "$lock_action" != reconcile ] || return 1
		if [ "$lock_elapsed" -ge "$lock_wait" ]; then
			public_failure lock_busy
			error '等待操作锁超时；可能仍有操作或遗留锁。请检查进程后重试，勿直接删除锁。'
		fi
		[ "$lock_elapsed" != 0 ] || printf 'AdZero: 正在等待当前操作完成（最多 %s 秒）…\n' "$lock_wait" >&2
		sleep 1
		lock_elapsed=$((lock_elapsed + 1))
	done
	printf '%s\n' 'AdZero kernel lease v1' > "$LOCK_DIR/lease" || error '无法记录操作租约。'
	lock_identity="$$ $lock_action"
	if ! printf '%s\n' "$lock_identity" > "$LOCK_DIR/owner"; then
		# This directory was just created by us. No recursive removal.
		rm -f "$LOCK_DIR/owner"; rmdir "$LOCK_DIR" 2>/dev/null || :
		error '无法记录操作锁所有者。'
	fi
	trap 'release_lock' 0
	trap 'exit 130' 1 2 3 15
	lock_start=$(process_start "$$") || error '无法核对操作进程身份。'
	printf '%s %s\n' "$lock_identity" "$lock_start" > "$LOCK_DIR/identity" || error '无法记录操作进程身份。'
	progress checking
}
# Store prior force_dns before changing anything. An unset value inherits the
# upstream default (currently 1); restore absence rather than hard-coding "1".
save_force_dns() {
	current=$(get_uci adblock-fast.config.force_dns)
	case "$current" in
		0|1) ;;
		'') current=unset ;;
		*) error '现有 force_dns 值未知，拒绝修改。' ;;
	esac
	printf '%s\n' "$current" > "$FORCE_BACKUP" || error '无法保存 DNS 劫持配置备份。'
}
save_tls_download() {
	current=$(get_uci adblock-fast.config.download_allow_insecure)
	case "$current" in
		0|1) ;;
		'') current=unset ;;
		*) error '当前证书校验配置未知，拒绝修改。' ;;
	esac
	printf '%s\n' "$current" > "$TLS_BACKUP" || error '无法备份证书校验配置。'
}
restore_tls_download() {
	[ -f "$TLS_BACKUP" ] || return 1
	original=$(cat "$TLS_BACKUP") || return 1
	case "$original" in
		0|1) write_uci adblock-fast.config.download_allow_insecure "$original" adblock-fast ;;
		unset) delete_uci adblock-fast.config.download_allow_insecure adblock-fast ;;
		*) return 1 ;;
	esac
}
restore_force_dns() {
	[ -f "$FORCE_BACKUP" ] || return 1
	original=$(cat "$FORCE_BACKUP") || return 1
	case "$original" in
		0|1) write_uci adblock-fast.config.force_dns "$original" adblock-fast ;;
		unset) delete_uci adblock-fast.config.force_dns adblock-fast ;;
		*) return 1 ;;
	esac
}
rollback_enable() {
	adapter_reload_pending && return 1
	old_enabled=$1
	"$ADAPTER" remove || return 1
	"$POLICY" restore || return 1
	write_uci adblock-fast.config.enabled "$old_enabled" adblock-fast || return 1
	restore_default_rule || return 1
	restore_force_dns || return 1
	restore_tls_download || return 1
	backend_restart || return 1
	# The AdZero UCI flag can also have been partially written on commit failure.
	write_uci adzero.main.enabled 0 adzero || return 1
	rm -f "$MANAGED_MARKER" "$FORCE_BACKUP" "$TLS_BACKUP" || return 1
}
verify_supported() {
	backend_available || error '未安装或无法调用 AdBlock-Fast 后端。'
	resolver_is_safe || error '当前 DNS 模式可能使用防火墙集合或不受支持，请改为安全的域名解析模式后重试。'
}
reject_insecure_custom_fetch_flags() {
	# curl_additional_param may override upstream download_allow_insecure=0.
	# Inspect locally, never print potentially credential-bearing parameters.
	params=$(get_uci adblock-fast.config.curl_additional_param)
	for token in $params; do
		case "$token" in
			*--insecure*|*--proxy-insecure*|--config*|-K*)
				error '检测到不安全或间接加载配置的 curl 参数，拒绝启用或刷新规则。' ;;
			--*) ;;
			-*) case "$token" in *k*|*K*) error '检测到不安全 curl 短参数，拒绝启用或刷新规则。' ;; esac ;;
		esac
	done
}
verify_policy_values() {
	[ "$(force_dns_state)" != unknown ] || error 'force_dns 配置值异常，拒绝接管。'
	[ "$(tls_download_state)" != unknown ] || error 'HTTPS 证书校验配置值异常，拒绝接管。'
	reject_insecure_custom_fetch_flags
}
enable_protection() {
	[ ! -e "$STATE_DIR/pause.json" ] || { resume_protection; return; }
	verify_supported
	policy_clean || error '上次放行操作尚未恢复，请先关闭并恢复。'
	# A reboot or time spent disabled must not turn a timed exception permanent.
	expire_allow || error '临时放行到期恢复未完成，请检查恢复记录。'
	"$ADAPTER" check >/dev/null || error '代理 DNS 适配前置检查失败，请查看诊断。'
	previous=$(get_uci adblock-fast.config.enabled)
	[ "$previous" = 1 ] || previous=0
	if [ -f "$MANAGED_MARKER" ]; then
		if [ "$(get_uci adzero.main.enabled)" = 1 ] && [ "$previous" = 1 ] && \
		   [ "$(force_dns_state)" = off ] && [ "$(tls_download_state)" = strict ] && \
		   [ -f "$FORCE_BACKUP" ] && [ -f "$TLS_BACKUP" ]; then
			[ "$(rule_sources_state)" = configured ] || error '缺少有效规则源，请关闭后重新启用以初始化默认规则。'
			backend_confirm ready || error '后端实际状态未确认，请检查诊断并关闭后重试。'
			"$ADAPTER" apply || error '代理 DNS 适配失败，请检查恢复记录。'
			printf 'already enabled (client DNS still unverified)\n'
			return 0
		fi
		error '上一次操作状态不一致，请先执行关闭并检查诊断结果。'
	fi
	[ "$previous" = 0 ] || error '后端已经由其他插件启用，AdZero 不会接管。'
	[ "$(get_uci adzero.main.enabled)" = 0 ] || error 'AdZero 配置与所有权不一致，请先排查。'
	[ ! -e "$FORCE_BACKUP" ] && [ ! -e "$TLS_BACKUP" ] && [ ! -e "$RULE_MARKER" ] || error '存在上次的恢复备份，拒绝覆盖；请先检查异常状态。'
	adguardhome_running && error 'AdGuard Home 正在运行，请先确认 DNS 链路。'
	verify_policy_values
	mkdir -p "$STATE_DIR" || error '无法创建状态目录。'
	save_force_dns
	save_tls_download
	: > "$MANAGED_MARKER" || error '无法记录后端所有权。'
	if ! write_uci adblock-fast.config.download_allow_insecure 0 adblock-fast; then
		rollback_enable "$previous" && error '启用 HTTPS 证书校验失败，原配置已恢复。'
		error '启用 HTTPS 证书校验失败，回滚未确认，请检查状态。'
	fi
	if ! write_uci adblock-fast.config.force_dns 0 adblock-fast; then
		rollback_enable "$previous" && error '关闭上游 DNS 劫持选项失败，原配置已恢复。'
		error '关闭上游 DNS 劫持选项失败，回滚未确认，请检查状态。'
	fi
	if ! write_uci adblock-fast.config.enabled 1 adblock-fast; then
		rollback_enable "$previous" && error '后端配置失败，原配置已恢复。'
		error '后端配置失败，回滚未确认，请检查状态。'
	fi
	if ! prepare_default_rule; then
		rollback_enable "$previous" && error '默认规则初始化失败，原配置已恢复。'
		error '默认规则初始化失败，回滚未确认，请检查状态。'
	fi
	if ! "$POLICY" apply; then
		rollback_enable "$previous" && error '个人放行配置应用失败，原配置已恢复。'
		error '个人放行配置未能恢复，请检查恢复记录。'
	fi
	start_method=start
	"$POLICY" has-allowed && start_method=dl
	[ ! -f "$STATE_DIR/sources-selected" ] || start_method=dl
	"$SOURCES" cache-check >/dev/null 2>&1 && start_method=start
	if [ "$start_method" = dl ] && [ -f "$STATE_DIR/sources-selected" ] && ! "$SOURCES" preflight; then
		rollback_enable "$previous" && error '规则容量预检未通过，原配置已恢复。'
		error '规则容量预检与恢复未确认，请保留恢复记录。'
	fi
	if ! backend_restart "$start_method"; then
		rule_failure_hint
		rollback_enable "$previous" && error '后端启动失败，原配置已恢复。'
		error '后端启动失败，回滚未确认，请检查状态。'
	fi
	if ! write_uci adzero.main.enabled 1 adzero; then
		rollback_enable "$previous" && error '状态保存失败，原配置已恢复。'
		error '状态保存失败，回滚未确认，请检查状态。'
	fi
	if ! "$ADAPTER" apply; then
		if adapter_reload_pending; then
			[ ! -x /etc/init.d/adzero ] || /etc/init.d/adzero start
			retain_pending_reload
		fi
		public_recovery unconfirmed
		if rollback_enable "$previous"; then public_recovery restored; error '代理 DNS 适配失败，原配置已恢复。'; fi
		error '代理 DNS 适配失败，恢复未完成；备份已保留。'
	fi
	[ ! -x /etc/init.d/adzero ] || /etc/init.d/adzero start
	printf 'enabled (force_dns disabled, real client DNS path not verified)\n'
}
disable_protection() {
	[ ! -x /etc/init.d/adzero ] || /etc/init.d/adzero stop
	"$ADAPTER" remove || error '代理 DNS 恢复失败，恢复记录已保留。'
	if ! sources_clean; then
		"$SOURCES" rollback && "$SOURCES" discard || error '规则变更恢复失败，恢复记录已保留。'
	fi
	if [ ! -f "$MANAGED_MARKER" ]; then
		"$POLICY" restore || error '放行恢复记录尚未处理。'
		"$POLICY" pause-clear || error '无法清除暂停记录。'
		if [ "$(get_uci adzero.main.enabled)" != 0 ]; then
			write_uci adzero.main.enabled 0 adzero || error '状态保存失败。'
		fi
		printf 'external backend left untouched\n'
		return 0
	fi
	backend_available || error '后端不可用，所有权标记已保留以便人工恢复。'
	[ -f "$FORCE_BACKUP" ] || error '缺少 force_dns 备份，拒绝猜测原始配置。'
	[ -f "$TLS_BACKUP" ] || error '缺少 HTTPS 证书校验备份，拒绝猜测原始配置。'
	# Preserve a native updater's newer list across disable/enable as well.
	"$SOURCES" cache-sync >/dev/null 2>&1 || :
	previous=$(get_uci adblock-fast.config.enabled)
	[ "$previous" = 1 ] || previous=0
	if [ "$previous" = 1 ]; then
		if ! write_uci adblock-fast.config.enabled 0 adblock-fast; then
			error '无法停用后端；所有权标记已保留。'
		fi
		if ! backend_restart; then
			write_uci adblock-fast.config.enabled 1 adblock-fast >/dev/null 2>&1 || :
			backend_restart >/dev/null 2>&1 || :
			error '停止后端失败；已尝试回到原来的启用状态。'
		fi
	fi
	"$POLICY" restore || error '后端放行配置恢复失败，所有权记录已保留。'
	if ! write_uci adzero.main.enabled 0 adzero; then
		if [ "$previous" = 1 ]; then
			write_uci adblock-fast.config.enabled 1 adblock-fast >/dev/null 2>&1 || :
			backend_restart >/dev/null 2>&1 || :
		fi
		error '状态保存失败，所有权标记已保留。'
	fi
	# Do not undo a manual change to force_dns made while AdZero was enabled.
	if [ "$(force_dns_state)" = off ]; then
		restore_force_dns || error '已停用后端，但恢复原始 force_dns 失败；请重试关闭。'
	fi
	if [ "$(tls_download_state)" = strict ]; then
		restore_tls_download || error '已停用后端，但恢复原始证书校验设置失败；请重试关闭。'
	fi
	restore_default_rule || error '后端已停用，但恢复默认规则配置失败；请重试关闭。'
	rm -f "$MANAGED_MARKER" "$FORCE_BACKUP" "$TLS_BACKUP" || error '已停用后端，但清理所有权状态失败。'
	"$POLICY" pause-clear || error '已关闭过滤，但暂停记录未能清理。'
	printf 'disabled (restored previous force_dns when unchanged)\n'
}

change_sources() {
	# Rule selections are explicit user configuration, retained after disable.
	verify_supported
	reject_insecure_custom_fetch_flags
	policy_clean || error '有未完成的配置恢复，请先关闭并恢复。'
	[ ! -e "$STATE_DIR/pause.json" ] || error '请先恢复保护或保持关闭，再管理规则。'
	active=0
	if [ -f "$MANAGED_MARKER" ]; then require_active; active=1
	else
		[ "$(get_uci adzero.main.enabled)" = 0 ] && [ "$(get_uci adblock-fast.config.enabled)" = 0 ] || error '过滤后端正由其他服务管理，拒绝更改规则。'
		[ ! -e "$FORCE_BACKUP" ] && [ ! -e "$TLS_BACKUP" ] || error '仍有未完成的恢复记录，请先关闭并恢复。'
	fi
	if "$SOURCES" begin "$@"; then
		if [ "$active" = 0 ] || { backend_rebuild_if_changed && "$ADAPTER" apply; }; then
			"$SOURCES" finish || error '规则已处理，但完成记录清理失败。'
			return 0
		fi
	fi
	if ! sources_clean; then
		retain_pending_reload
		"$SOURCES" rollback || error '规则恢复遇到并发修改，恢复记录已保留。'
		if [ "$active" = 0 ] || { backend_restart dl && "$ADAPTER" apply; }; then
			"$SOURCES" discard || error '旧规则已恢复，但记录清理失败。'
			error '规则变更未完成，已恢复原配置。'
		fi
		error '规则变更未完成，恢复记录已保留，请关闭并恢复。'
	fi
	error '规则未应用，请检查订阅地址和格式。'
}
strict_dns_selected() {
	[ -n "$(get_uci adzero.main.dns_profile)" ] && "$SOURCES" strict >/dev/null 2>&1
}
apply_settings() {
	verify_supported
	reject_insecure_custom_fetch_flags
	policy_clean || error '有未完成的配置恢复，请先关闭并恢复。'
	[ ! -e "$STATE_DIR/pause.json" ] || error '请先恢复保护或保持关闭，再应用更改。'
	active=0
	if [ -f "$MANAGED_MARKER" ]; then require_active; active=1
	else
		[ "$(get_uci adzero.main.enabled)" = 0 ] && [ "$(get_uci adblock-fast.config.enabled)" = 0 ] || error '后端正由其他服务管理。'
		[ ! -e "$FORCE_BACKUP" ] && [ ! -e "$TLS_BACKUP" ] || error '存在未完成恢复记录。'
	fi
	settings_file=$1
	settings_plan=$("$SOURCES" plan-check "$settings_file") || error '待应用配置检查失败。'
	case "$settings_plan" in [01]' '[01]' '[01]' '[01]) ;; *) error '批量应用计划无效。' ;; esac
	# Fixed digits emitted by the local validator; no user strings in splitting.
	set -- $settings_plan
	rules_changed=$1; routing_changed=$2; wanted=$3; dns_changed=$4
	if [ "$rules_changed$routing_changed$dns_changed" = 000 ]; then printf 'no pending changes\n'; return 0; fi
	if [ "$active" = 1 ] && [ "$dns_changed" = 1 ]; then
		"$ADAPTER" dns-check "$settings_file" || error 'DNS 组合预检未通过，未修改配置或重载网络。'
	fi
	if [ "$rules_changed$dns_changed" = 00 ]; then
		if [ "$active" = 1 ]; then change_routing "$wanted"
		else "$POLICY" routing-begin "$wanted" && "$POLICY" routing-save && "$POLICY" routing-finish || error '分流选择保存失败。'; fi
		return 0
	fi
	routing_method=full
	if [ "$routing_changed" = 1 ] && [ "$active" = 1 ]; then
		# Both preflights must inspect the same candidate. The old DNS policy
		# may be incompatible with a newly selected proxy and need correction.
		routing_method=$("$ADAPTER" routing-check "$wanted" "$settings_file") || error '分流配置预检未通过，尚未应用更改。'
	fi
	if "$SOURCES" begin-batch "$settings_file"; then
		applied=0
		if [ "$active" = 0 ]; then applied=1
		elif [ "$rules_changed$routing_changed" = 00 ]; then applied=1
		elif [ "$routing_changed" = 0 ]; then backend_rebuild_if_changed && "$ADAPTER" apply && applied=1
		elif [ "$routing_method" = nailink ] || [ "$routing_method" = passwall ]; then
			if [ "$rules_changed" = 0 ]; then "$ADAPTER" "reconfigure-$routing_method" && applied=1
			else backend_rebuild_if_changed && "$ADAPTER" "reconfigure-$routing_method-rules" && applied=1; fi
		else "$ADAPTER" detach && { [ "$rules_changed" = 0 ] || backend_rebuild_if_changed; } && "$ADAPTER" apply && applied=1
		fi
		if [ "$applied" = 1 ]; then
			"$SOURCES" finish || error '更改已应用，但完成记录未能清理。'
			if [ "$active" = 1 ] && [ "$dns_changed" = 1 ]; then
				[ ! -x /etc/init.d/adzero ] || /etc/init.d/adzero reload || error 'DNS 已应用，但后台检查服务未能刷新。'
			fi
			return 0
		fi
	fi
	if ! sources_clean; then
		retain_pending_reload
		public_recovery unconfirmed
		"$SOURCES" rollback || error '批量恢复遇到并发修改，恢复记录已保留。'
		restored=0
		if [ "$active" = 0 ]; then restored=1
		elif [ "$routing_changed" = 1 ] && { [ "$routing_method" = nailink ] || [ "$routing_method" = passwall ]; }; then
			if [ "$rules_changed" = 0 ]; then "$ADAPTER" "reconfigure-$routing_method" && restored=1
			else backend_restart dl && "$ADAPTER" "reconfigure-$routing_method-rules" && restored=1; fi
		else
			if [ "$routing_changed" = 1 ]; then "$ADAPTER" detach || error '代理恢复未完成，批量记录已保留。'; fi
			{ [ "$rules_changed" = 0 ] || backend_restart dl; } && "$ADAPTER" apply && restored=1
		fi
		if [ "$restored" = 1 ]; then "$SOURCES" discard || error '旧配置已恢复，但记录未清理。'; public_recovery restored; error '更改未能应用，已恢复之前的配置。'; fi
		error '更改与恢复尚未确认，记录已保留。'
	fi
	error '更改尚未应用，请检查规则校验结果。'
}
refresh_blocklists() {
	[ ! -e "$STATE_DIR/pause.json" ] || error '请先恢复保护，再更新规则。'
	policy_clean || error '放行恢复尚未完成，请先关闭并恢复。'
	verify_supported
	[ -f "$MANAGED_MARKER" ] || error '后端非 AdZero 管理，拒绝更新规则。'
	[ "$(get_uci adzero.main.enabled)" = 1 ] || error 'AdZero 未启用。'
	[ "$(get_uci adblock-fast.config.enabled)" = 1 ] || error '后端未启用。'
	[ -f "$FORCE_BACKUP" ] || error '原始 DNS 劫持配置备份丢失，拒绝更新。'
	[ -f "$TLS_BACKUP" ] || error '原始证书校验配置备份丢失，拒绝更新。'
	[ "$(force_dns_state)" = off ] || error '上游 DNS 劫持选项被外部更改，拒绝更新。'
	[ "$(tls_download_state)" = strict ] || error 'HTTPS 证书校验被外部关闭，拒绝更新规则。'
	[ "$(rule_sources_state)" = configured ] || error '没有有效规则源，拒绝空更新。'
	reject_insecure_custom_fetch_flags
	change_sources refresh
}
change_routing() {
	case "$1" in 0|1) ;; *) error '自动分流开关无效。' ;; esac
	if [ "$1" = 0 ] && strict_dns_selected; then error '请同时关闭严格 DNS，再关闭自动分流。'; fi
	require_active
	[ "$(get_uci adzero.main.routing_enabled)" != "$1" ] || { printf 'routing preference already applied\n'; return 0; }
	routing_method=$("$ADAPTER" routing-check "$1") || error '当前代理配置未通过分流预检，原接入保持不变。'
	"$POLICY" routing-begin "$1" || error '未能准备自动分流切换。'
	if [ "$routing_method" = nailink ] || [ "$routing_method" = passwall ]; then
		if "$POLICY" routing-save && "$ADAPTER" "reconfigure-$routing_method"; then
			"$POLICY" routing-finish || error '分流已应用，但完成记录未能清理。'
			printf 'routing preference synchronized with one proxy reload\n'; return 0
		fi
		retain_pending_reload
		if "$POLICY" routing-rollback && "$ADAPTER" apply; then
			"$POLICY" routing-finish || error '原配置已恢复，但切换记录未清理。'
			error '自动分流切换未完成，已恢复原配置。'
		fi
		error '自动分流切换与恢复未确认，请关闭并恢复；记录已保留。'
	fi
	if "$ADAPTER" detach && "$POLICY" routing-save && "$ADAPTER" apply; then
		"$POLICY" routing-finish || error '分流已应用，但完成记录未能清理。'
		printf 'routing preference synchronized\n'; return 0
	fi
	if "$ADAPTER" detach && "$POLICY" routing-rollback && "$ADAPTER" apply; then
		"$POLICY" routing-finish || error '原配置已恢复，但切换记录未清理。'
		error '自动分流切换未完成，已恢复原配置。'
	fi
	error '自动分流切换与恢复未确认，请关闭并恢复；记录已保留。'
}

require_active() {
	verify_supported
	[ -f "$MANAGED_MARKER" ] && [ "$(get_uci adzero.main.enabled)" = 1 ] && \
	[ "$(get_uci adblock-fast.config.enabled)" = 1 ] && [ ! -e "$STATE_DIR/pause.json" ] || error '请先开启或恢复 AdZero。'
	[ "$(force_dns_state)" = off ] && [ "$(tls_download_state)" = strict ] || error '过滤配置已被外部修改。'
	[ -f "$FORCE_BACKUP" ] && [ -f "$TLS_BACKUP" ] || error '原始配置备份丢失，请先检查恢复记录。'
	policy_clean || error '上次放行操作尚未恢复，请先关闭并恢复。'
	backend_confirm ready || error '当前规则未就绪，请重新检测。'
	"$SOURCES" cache-sync || error '下载快照检查失败，请重新检测。'
}
change_controls() {
	verify_supported
	reject_insecure_custom_fetch_flags
	policy_clean || error '有未完成的恢复记录，请先关闭并恢复。'
	[ ! -e "$STATE_DIR/pause.json" ] || error '请先恢复保护或保持关闭，再应用访问控制。'
	active=0
	if [ -f "$MANAGED_MARKER" ]; then require_active; active=1
	else
		[ "$(get_uci adzero.main.enabled)" = 0 ] && [ "$(get_uci adblock-fast.config.enabled)" = 0 ] || error '后端正由其他服务管理。'
		[ ! -e "$FORCE_BACKUP" ] && [ ! -e "$TLS_BACKUP" ] || error '存在未完成恢复记录。'
	fi
	plan=$("$POLICY" controls-check "$1") || error '访问控制预检失败，尚未应用。'
	[ "$plan" != 0 ] || { printf 'no control changes\n'; return 0; }
	[ "$plan" = 1 ] || error '访问控制计划无效。'
	if "$POLICY" begin-controls "$1"; then
		if [ "$active" = 0 ] || { backend_rebuild_if_changed && "$ADAPTER" apply; }; then
			"$POLICY" finish || error '访问控制已应用，但完成记录清理失败。'
			printf 'access controls applied\n'; return 0
		fi
	fi
	if "$POLICY" pending; then
		retain_pending_reload
		"$POLICY" rollback || error '访问控制恢复遇到并发修改，记录已保留。'
		if [ "$active" = 0 ] || { backend_restart dl && "$ADAPTER" apply; }; then
			"$POLICY" finish || error '旧名单已恢复，但记录未能清理。'
			error '访问控制未应用，已恢复原名单。'
		fi
		error '访问控制与恢复尚未完成，记录已保留。'
	fi
	error '访问控制尚未应用，请检查名单。'
}
change_allow() {
	require_active
	# Journal intent before UCI writes; both backend and adapter must succeed.
	if "$POLICY" "begin-$1" "$2" "$3" "$4" && backend_rebuild_if_changed && "$ADAPTER" apply; then
		"$POLICY" finish || error '放行已同步，完成记录清理失败。'
		printf 'personal allow policy synchronized\n'
		return 0
	fi
	if "$POLICY" pending; then
		retain_pending_reload
		if "$POLICY" rollback && backend_restart dl && "$ADAPTER" apply; then
			"$POLICY" finish || error '已恢复旧名单，完成记录清理失败。'
			error '放行操作未完成，已恢复原名单。'
		fi
		error '放行操作未完成，恢复记录已保留；请关闭并恢复。'
	fi
	error '放行未应用，请重新查询并确认范围。'
}
expire_allow() {
	[ -s "$STATE_DIR/temporary-allow.json" ] || return 0
	"$POLICY" temporary-due || return 0
	# Expiry must also work after protection was disabled, without re-enabling it.
	"$POLICY" begin-expire || { "$POLICY" temporary-backoff; return 1; }
	if [ -f "$MANAGED_MARKER" ] && [ "$(get_uci adblock-fast.config.enabled)" = 1 ]; then
		backend_rebuild_if_changed && "$ADAPTER" apply || {
			"$POLICY" rollback && backend_restart dl && "$ADAPTER" apply && "$POLICY" finish
			"$POLICY" temporary-backoff
			return 1
		}
	fi
	"$POLICY" finish
}
pause_protection() {
	case "$1" in 300|900|1800) ;; *) error '暂停时长仅支持 5、15、30 分钟。' ;; esac
	if strict_dns_selected; then error '严格 DNS 模式下不能临时暂停；请先关闭严格模式，或使用关闭并恢复。'; fi
	require_active
	"$POLICY" pause-begin "$1" || error '未能记录暂停计划。'
	"$ADAPTER" remove || error '代理规则未恢复，暂停未完成；请关闭并恢复。'
	write_uci adblock-fast.config.enabled 0 adblock-fast && backend_restart || error '后端未能停止，暂停未完成；请关闭并恢复。'
	"$POLICY" pause-stage paused || error '暂停完成记录失败；请重新检测。'
	printf 'paused; owned proxy rules removed, automatic resume scheduled\n'
}
resume_protection() {
	"$POLICY" is-paused || error '没有可以恢复的暂停计划。'
	[ -f "$MANAGED_MARKER" ] && [ "$(get_uci adzero.main.enabled)" = 1 ] && \
	[ "$(get_uci adblock-fast.config.enabled)" = 0 ] || error '暂停期间配置已被修改，拒绝自动接管。'
	if ! (verify_supported; [ "$(force_dns_state)" = off ] && [ "$(tls_download_state)" = strict ] &&
		! adguardhome_running && "$ADAPTER" check >/dev/null && policy_clean); then
		"$POLICY" pause-stage paused resume_failed
		error '恢复前检查未通过，继续保持暂停，请检查当前代理后重试。'
	fi
	"$POLICY" pause-stage resuming || error '无法记录恢复操作。'
	if write_uci adblock-fast.config.enabled 1 adblock-fast && backend_restart && "$ADAPTER" apply; then
		"$POLICY" pause-clear || error '保护已恢复，暂停记录未能清理。'
		printf 'resumed\n'; return 0
	fi
	if "$ADAPTER" remove && write_uci adblock-fast.config.enabled 0 adblock-fast && backend_restart; then
		"$POLICY" pause-stage paused resume_failed
		error '恢复未完成，已回到暂停状态；可稍后重试。'
	fi
	"$POLICY" pause-stage recovery_required
	error '恢复未确认，恢复记录已保留，请关闭并恢复。'
}

case "$1" in
	status) print_status ;;
	enhance-status) "$(dirname "$0")/dns-enhance" status ;;
	enhance-save) acquire_lock enhance-save;
		"$(dirname "$0")/dns-enhance" save "$2" || error '增强设置未保存。'
		if [ "$(get_uci adzero.main.enabled)" = 1 ] && [ -x /etc/init.d/adzero ]; then
			"$ADAPTER" apply || error '增强设置已保存，但原生接入未确认；请检查恢复记录。'
			/etc/init.d/adzero reload || error '设置已保存，但增强实例未确认启动。'
		fi ;;
	dns-test) "$(dirname "$0")/dns-enhance" test ;;
	dns-switch) acquire_lock dns-switch; require_active;
		plan=$("$(dirname "$0")/dns-enhance" switch-plan "$2" "$3" "$4") || error '备用 DNS 未通过切换前检查。'
		apply_settings "$plan" ;;
	sources-list) "$SOURCES" list ;;
	source-add) acquire_lock source-add; shift; change_sources add "$@" ;;
	source-toggle) acquire_lock source-toggle; shift; change_sources toggle "$@" ;;
	source-remove) acquire_lock source-remove; shift; change_sources remove "$@" ;;
	source-verify) acquire_lock source-verify; verify_supported; policy_clean || error '请先完成恢复。';
		[ -f "$MANAGED_MARKER" ] || { [ "$(get_uci adzero.main.enabled)" = 0 ] && [ "$(get_uci adblock-fast.config.enabled)" = 0 ]; } || error '后端由其他服务管理。';
		"$SOURCES" verify ;;
	source-refresh) acquire_lock source-refresh; change_sources refresh ;;
	reload) acquire_lock reload; reload_current ;;
	settings-apply) acquire_lock settings-apply; apply_settings "$2" ;;
	controls-apply) acquire_lock controls-apply; change_controls "$2" ;;
	enable) acquire_lock enable; enable_protection ;;
	disable) acquire_lock disable; disable_protection ;;
	refresh) acquire_lock refresh; refresh_blocklists ;;
	lookup) acquire_lock lookup; require_active; "$POLICY" lookup "$2" ;;
	allow|revoke|temporary) acquire_lock "$1"; change_allow "$1" "$2" "$3" "$4" ;;
	temporary-expire) acquire_lock temporary-expire; expire_allow ;;
	pause) acquire_lock pause; pause_protection "$2" ;;
	resume) acquire_lock resume; resume_protection ;;
	routing-on|routing-off) acquire_lock "$1"; if [ "$1" = routing-on ]; then change_routing 1; else change_routing 0; fi ;;
	reconcile)
		# A skipped lock is temporary contention, not a completed handoff.
		# Keep scheduled retries silent while giving the watcher a real receipt.
		acquire_lock reconcile || exit 75
		if [ -f "$MANAGED_MARKER" ] && [ "$(get_uci adzero.main.enabled)" = 1 ]; then
			expire_allow || exit 1
			if [ -e "$STATE_DIR/pause.json" ]; then
				if "$POLICY" pause-due; then resume_protection; fi
			else
				if adapter_reload_pending; then finish_pending_reload || exit 1; fi
				policy_clean && backend_confirm ready && "$ADAPTER" apply
			fi
		fi ;;
	*) error '用法: ctl {status|enable|disable|refresh|lookup DOMAIN|allow DOMAIN SCOPE|revoke DOMAIN SCOPE|pause SECONDS|resume}' ;;
esac
