#!/bin/sh
# Read-only capability inventory. Never source firmware or proxy configuration.
set -f
LC_ALL=C
export LC_ALL
ROOT=${ADZERO_PROBE_ROOT:-/}
ROOT=${ROOT%/}
UCI=${ADZERO_UCI:-uci}
PIDOF=${ADZERO_PIDOF:-pidof}
UBUS=${ADZERO_UBUS:-ubus}
JSONFILTER=${ADZERO_JSONFILTER:-jsonfilter}
OPKG=${ADZERO_OPKG:-opkg}
APK=${ADZERO_APK:-apk}
UNAME=${ADZERO_UNAME:-uname}

value() { "$UCI" -q get "$1" 2>/dev/null || :; }
has_command() { command -v "$1" >/dev/null 2>&1; }
running() { has_command "$PIDOF" && "$PIDOF" "$1" >/dev/null 2>&1; }
bool() { if [ "$1" = 1 ]; then printf true; else printf false; fi; }
quote() {
	# BusyBox on OpenWrt may omit od. The sentinel preserves trailing newlines.
	# Shell variables cannot contain NUL; escape every other JSON control byte.
	printf '%s_' "$1" | awk '
	BEGIN { for (n=1;n<32;n++) escapes[sprintf("%c",n)]=sprintf("\\u%04x",n) }
	{ data=data (NR>1 ? "\n" : "") $0 }
	END {
		printf "\""
		for (i=1;i<length(data);i++) {
			c=substr(data,i,1)
			if (c=="\"") printf "\\\""
			else if (c=="\\") printf "\\\\"
			else if (c in escapes) printf "%s", escapes[c]
			else printf "%s", c
		}
		printf "\""
	}'
}
release_value() {
	[ -r "$1" ] || return 0
	awk -v key="$2" 'index($0,key "=")==1 {
		v=substr($0,length(key)+2); sub(/\r$/, "", v)
		if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v=substr(v,2,length(v)-2)
		print v; exit
	}' "$1"
}
service_state() {
	# Shared mihomo/xray processes cannot establish which plugin owns them.
	# The service name and running flag must both match a procd instance.
	if has_command "$UBUS" && has_command "$JSONFILTER"; then
		result=$("$UBUS" -S call service list "{\"name\":\"$1\"}" 2>/dev/null) || {
			printf unknown; return
		}
		values=$(printf '%s' "$result" | "$JSONFILTER" -e "@[\"$1\"].instances.*.running" 2>/dev/null) || {
			printf unknown; return
		}
		if printf '%s\n' "$values" | grep -qx true; then printf running; return; fi
		if printf '%s\n' "$values" | grep -qx false; then printf stopped; return; fi
	fi
	printf unknown
}
plugin() {
	plugin_id=$1; service=$2; enabled_key=$3; hint_key=$4
	installed=0; enabled=false; runtime=unknown; hint=unknown
	if [ -e "$ROOT/etc/config/$service" ] || [ -e "$ROOT/etc/init.d/$service" ]; then installed=1; fi
	if [ "$plugin_id" = nailink ]; then
		[ -e "$ROOT/usr/share/daed-router/version" ] && installed=1
		# Only the exact daed process is attributable; raw dae stays a separate core.
		if running daed; then installed=1; runtime=running; fi
	fi
	case "$(value "$enabled_key")" in 1) enabled=true ;; 0) enabled=false ;; *) enabled=null ;; esac
	[ "$installed" = 1 ] && [ "$runtime" = unknown ] && runtime=$(service_state "$service")
	case "$plugin_id" in
		openclash) case "$(value "$hint_key")" in 0) hint=disabled ;; 1) hint=plugin_redirect ;; 2) hint=firewall_redirect ;; esac ;;
		passwall|passwall2|nikki) case "$(value "$hint_key")" in 0) hint=disabled ;; 1) hint=plugin_redirect ;; esac ;;
		nailink) hint=proxy_core_dns ;;
	esac
	[ "$installed" = 1 ] && proxy_count=$((proxy_count+1))
	if [ "$installed" = 1 ] && { [ "$enabled" = true ] || [ "$runtime" = running ]; }; then
		active_proxy_count=$((active_proxy_count+1))
	fi
	printf '%s{"id":"%s","installed":%s,"enabled":%s,"runtime":"%s","dns_hint":"%s","integration":"unverified"}' \
		"$comma" "$plugin_id" "$(bool "$installed")" "$enabled" "$runtime" "$hint"
	comma=,
}

vendor=$(release_value "$ROOT/etc/openwrt_release" DISTRIB_ID)
version=$(release_value "$ROOT/etc/openwrt_release" DISTRIB_RELEASE)
target=$(release_value "$ROOT/etc/openwrt_release" DISTRIB_TARGET)
declared_arch=$(release_value "$ROOT/etc/openwrt_release" DISTRIB_ARCH)
[ -n "$vendor" ] || vendor=$(release_value "$ROOT/etc/os-release" NAME)
[ -n "$version" ] || version=$(release_value "$ROOT/etc/os-release" VERSION_ID)
case "$(printf '%s' "$vendor" | tr 'A-Z' 'a-z')" in
	*istoreos*) family=istoreos ;;
	*immortalwrt*) family=immortalwrt ;;
	*openwrt*) family=openwrt ;;
	*) family=unknown ;;
esac
case "$version" in
	24.10|24.10.*|25.12|25.12.*) release_track=candidate ;;
	23.05|23.05.*) release_track=legacy_candidate ;;
	*SNAPSHOT*|*snapshot*) release_track=snapshot ;;
	*) release_track=unvalidated ;;
esac
cpu=$("$UNAME" -m 2>/dev/null || printf unknown)
kernel=$("$UNAME" -r 2>/dev/null || printf unknown)
package_manager=unknown; package_arch=unknown
has_opkg=0; has_apk=0
has_command "$OPKG" && has_opkg=1
has_command "$APK" && has_apk=1
opkg_db=0; apk_db=0
[ -f "$ROOT/usr/lib/opkg/status" ] || [ -f "$ROOT/var/lib/opkg/status" ] && opkg_db=1
[ -f "$ROOT/lib/apk/db/installed" ] && apk_db=1
if [ "$opkg_db" = 1 ] && [ "$apk_db" = 1 ]; then
	package_manager=ambiguous
elif [ "$opkg_db" = 1 ] && [ "$has_opkg" = 1 ]; then
	package_manager=opkg
elif [ "$apk_db" = 1 ] && [ "$has_apk" = 1 ]; then
	package_manager=apk
elif [ "$has_opkg" = 1 ] && [ "$has_apk" = 0 ]; then
	package_manager=opkg
elif [ "$has_apk" = 1 ] && [ "$has_opkg" = 0 ]; then
	package_manager=apk
elif [ "$has_apk" = 1 ] && [ "$has_opkg" = 1 ]; then
	package_manager=ambiguous
fi
case "$package_manager" in
	opkg) package_arch=$("$OPKG" print-architecture 2>/dev/null | awk '$1=="arch" && $2!="all" && $2!="noarch" && $3+0>p {a=$2;p=$3+0} END {print a}') ;;
	apk) package_arch=$("$APK" --print-arch 2>/dev/null) ;;
esac
[ -n "$package_arch" ] || package_arch=unknown
case "$package_arch" in *[!a-zA-Z0-9_+-]*) package_arch=unknown ;; esac
modern_luci=0
[ -f "$ROOT/www/luci-static/resources/view.js" ] && modern_luci=1
memory_kib=$(awk '/^MemTotal:/ {print $2; exit}' "$ROOT/proc/meminfo" 2>/dev/null)
case "$memory_kib" in ''|*[!0-9]*) memory_kib=0 ;; esac
resource_hint=unknown
if [ "$memory_kib" -gt 0 ]; then
	if [ "$memory_kib" -lt 65536 ]; then resource_hint=low_memory; else resource_hint=normal; fi
fi
printf '{"schema_version":1,"platform":{"family":"%s","distribution":%s,"version":%s,"release_track":"%s","target":%s,"cpu":%s,"kernel":%s,"declared_arch":%s,"package_manager":"%s","package_arch":%s,"modern_luci":%s,"memory_kib":%s,"resource_hint":"%s","validation":"not_device_tested"},"plugins":[' \
	"$family" "$(quote "$vendor")" "$(quote "$version")" "$release_track" "$(quote "$target")" \
	"$(quote "$cpu")" "$(quote "$kernel")" "$(quote "$declared_arch")" "$package_manager" \
	"$(quote "$package_arch")" "$(bool "$modern_luci")" "$memory_kib" "$resource_hint"
comma=; proxy_count=0; active_proxy_count=0
plugin nailink daed daed.main.enabled ''
plugin passwall passwall 'passwall.@global[0].enabled' 'passwall.@global[0].dns_redirect'
plugin passwall2 passwall2 'passwall2.@global[0].enabled' 'passwall2.@global[0].dns_redirect'
plugin openclash openclash openclash.config.enable openclash.config.enable_redirect_dns
plugin nikki nikki nikki.config.enabled nikki.proxy.ipv4_dns_hijack
printf '],"cores":['
comma=
for core in dae daed mihomo clash xray sing-box; do
	if running "$core"; then printf '%s"%s"' "$comma" "$core"; comma=,; fi
done
printf '],"resolvers":['
comma=
for resolver in dnsmasq smartdns unbound AdGuardHome; do
	if running "$resolver"; then printf '%s"%s"' "$comma" "$resolver"; comma=,; fi
done
dnsmasq_instances=0; disabled_instances=0
while [ "$dnsmasq_instances" -lt 64 ] && [ "$(value "dhcp.@dnsmasq[$dnsmasq_instances]")" = dnsmasq ]; do
	[ "$(value "dhcp.@dnsmasq[$dnsmasq_instances].port")" = 0 ] && disabled_instances=$((disabled_instances+1))
	dnsmasq_instances=$((dnsmasq_instances+1))
done
printf '],"dns":{"dnsmasq_instances":%s,"disabled_instances":%s,"inventory_truncated":%s,"proxy_count":%s,"active_proxy_count":%s,"client_path":"unverified","ipv6_path":"unverified","encrypted_dns_bypass":"possible"}}\n' \
	"$dnsmasq_instances" "$disabled_instances" "$(if [ "$dnsmasq_instances" = 64 ]; then printf true; else printf false; fi)" "$proxy_count" "$active_proxy_count"
