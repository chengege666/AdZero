#!/bin/sh
# Official release updater: exact GitHub HTTPS asset SHA-256, no user URLs,
# no eval or curl --insecure. Only invokes published install.sh after --check.
set -eu
set -f
umask 077

root=${ADZERO_INSTALL_ROOT:-}
state=${ADZERO_UPDATE_STATE:-/tmp/adzero-update}
version_file=${ADZERO_UPDATE_VERSION_FILE:-"$root/usr/share/adzero/version"}
parser=${ADZERO_UPDATE_PARSER:-"$root/usr/libexec/adzero/update-check.uc"}
curl_bin=${ADZERO_UPDATE_CURL:-curl}
ucode_bin=${ADZERO_UPDATE_UCODE:-ucode}
api_url='https://api.github.com/repos/slobys/AdZero/releases?per_page=20'
base='https://github.com/slobys/AdZero/releases/download'
job=${ADZERO_JOB_CONTEXT:-}
installer=

fail()lock_owned=0

fail() { printf 'AdZero 更新：%s\n' "$*" >&2; exit 1; }
version_valid() { printf '%s\n' "$1" | grep -Eq '^v[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$'; }
current_version() {
	current=$(cat "$version_file" 2>/dev/null || :)
	version_valid "v$current" || fail '本机安装包版本标记无效，拒绝在线升级。'
	printf 'v%s\n' "$current"
}
is_newer() {
	# Bounded numeric SemVer, not lexicographic ordering.
	new=${1#v}; old=${2#v}
	na=${new%%.*}; nrest=${new#*.}; nb=${nrest%%.*}; nc=${nrest#*.}
	oa=${old%%.*}; orest=${old#*.}; ob=${orest%%.*}; oc=${orest#*.}
	[ "$na" -gt "$oa" ] && return 0
	[ "$na" -lt "$oa" ] && return 1
	[ "$nb" -gt "$ob" ] && return 0
	[ "$nb" -lt "$ob" ] && return 1
	[ "$nc" -gt "$oc" ]
}
prepare() {
	command -v "$curl_bin" >/dev/null 2>&1 || fail '缺少 curl HTTPS 下载程序。'
	command -v "$ucode_bin" >/dev/null 2>&1 || fail '缺少 ucode JSON 解析程序。'
	command -v sha256sum >/dev/null 2>&1 || fail '缺少 SHA-256 校验程序。'
	[ ! -L "$state" ] || fail '更新状态目录不可使用符号链接。'
	mkdir -p "$state" || fail '无法创建更新状态目录。'
	[ -d "$state" ] && [ ! -L "$state" ] || fail '更新状态目录无效。'
	chmod 700 "$state"
}
download() {
	"$curl_bin" --fail --silent --show-error --location \
		--proto '=https' --proto-redir '=https' --connect-timeout 12 \
		--max-time 80 --max-filesize 1048576 --output "$2" "$1"
}
verify_hash() {
	got=$(sha256sum "$1") || return 1
	[ "${got%% *}" = "$2" ]
}
parse_release() {
	file=$(mktemp "$state/releases.XXXXXXXX") || return 1
	if ! download "$api_url" "$file"; then rm -f "$file"; return 1; fi
	tag_and_digest=$("$ucode_bin" "$parser" "$file") || {
		rm -f "$file"; return 1
	}
	rm -f "$file"
	set -- $tag_and_digest
	[ "$#" = 2 ] || return 1
	version_valid "$1" || return 1
	printf '%s' "$2" | grep -Eq '^[a-f0-9]{64}$' || return 1
	target=$1; digest=$2
}
stage() {
	[ -n "$job" ] && [ -d "$job" ] && [ ! -L "$job" ] &&
		printf '%s\n' "$1" > "$job/stage" || :
}
verify_installer() {
	download "$base/$target/install.sh" "$installer" || return 1
	verify_hash "$installer" "$digest" || return 1
	# The official release installer checks platform/ABI/package SHA-256.
	# Its --check path never installs, changes DNS or stops protection.
	sh "$installer" --base-url "$base/$target" --check
}
acquire() {
	[ ! -L "$state/lock" ] && mkdir "$state/lock" 2>/dev/null ||
		fail '已有更新检查或升级任务正在运行，请勿重复提交。'
	lock_owned=1
}
clean() {
	[ -z "$installer" ] || rm -f "$installer"
	[ "$lock_owned" = 0 ] || rmdir "$state/lock" 2>/dev/null || :
}
trap 'clean' 0
trap 'exit 130' 1 2 3 15

case "${1:-}" in
check)
	prepare
	acquire
	current=$(current_version)
	# A failed check must never leave an older upgrade approval active.
	rm -f "$state/approved" "$state/approved.new"
	stage checking
	if ! parse_release; then
		printf '{"ok":false,"message":"无法读取 GitHub 官方版本信息，请检查网络或稍后重试。","current":"%s"}\n' "$current"
		exit 0
	fi
	if ! is_newer "$target" "$current"; then
		printf '{"ok":true,"available":false,"compatible":true,"current":"%s","latest":"%s"}\n' "$current" "$target"
		exit 0
	fi
	stage downloading
	installer=$(mktemp "$state/installer.XXXXXXXX") || fail '无法准备下载文件。'
	if ! verify_installer >/dev/null 2>&1; then
		printf '{"ok":true,"available":true,"compatible":false,"current":"%s","latest":"%s","message":"新版本已发布，但当前固件未通过安装包校验；原有保护没有改变。"}\n' "$current" "$target"
		exit 0
	fi
	printf '%s %s %s\n' "$target" "$digest" "$(date +%s)" > "$state/approved.new" || fail '无法保存校验记录。'
	mv "$state/approved.new" "$state/approved" || fail '无法确认更新校验结果。'
	printf '{"ok":true,"available":true,"compatible":true,"current":"%s","latest":"%s"}\n' "$current" "$target"
	;;
upgrade)
	[ "$#" = 2 ] && version_valid "$2" || fail '无效升级版本。'
	prepare
	acquire
	[ -f "$state/approved" ] && [ ! -L "$state/approved" ] || fail '请先在 AdZero 页面检查可用更新。'
	IFS=' ' read -r target digest timestamp < "$state/approved" || fail '校验记录不完整。'
	version_valid "$target" || fail '校验记录中的版本无效。'
	[ "$2" = "$target" ] || fail '待更新版本已变化，请重新检查并确认。'
	printf '%s' "$digest" | grep -Eq '^[a-f0-9]{64}$' || fail '下载校验值无效。'
	case "$timestamp" in ''|*[!0-9]*) fail '校验时间无效。' ;; esac
	now=$(date +%s)
	[ "$now" -ge "$timestamp" ] && [ "$((now-timestamp))" -le 900 ] || fail '更新校验已超过 15 分钟，请重新检查。'
	current=$(current_version)
	is_newer "$target" "$current" || fail '该版本不高于本机版本，拒绝重复升级。'
	# One-time user approval; never automatically retry package changes.
	rm -f "$state/approved"
	stage downloading
	installer=$(mktemp "$state/installer.XXXXXXXX") || fail '无法准备升级脚本。'
	stage validating
	verify_installer || fail '官方安装脚本或 SDK 包校验失败，未执行升级。'
	stage restoring
	sh "$installer" --base-url "$base/$target" --upgrade ||
		fail '升级未完成，请保留恢复记录，不要连续点击。'
	stage verifying
	printf '%s\n' 'AdZero: 已完成安装器升级流程，请刷新页面验证新版本。'
	;;
*) fail '用法: update {check | upgrade VERSION}' ;;
esac
