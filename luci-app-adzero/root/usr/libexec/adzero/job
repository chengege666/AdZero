#!/bin/sh
# A short RPC launches a worker with detached stdio. ctl owns serialization.
umask 077
set -f
jobs=${ADZERO_JOB_DIR:-/tmp/adzero-jobs}
ctl=${ADZERO_JOB_CTL:-$(dirname "$0")/ctl}
case "$1" in
 start)
	shift
	case "$1" in enable|disable|refresh|reload|allow|revoke|temporary|pause|resume|routing-on|routing-off|source-add|source-toggle|source-remove|source-refresh|source-verify|settings-apply|controls-apply|enhance-save|dns-test) ;; *) exit 1 ;; esac
	[ ! -L "$jobs" ] || exit 1
	mkdir -p "$jobs" || exit 1
	id=$(cat /proc/sys/kernel/random/uuid) || exit 1
	printf '%s\n' "$id" | grep -Eq '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$' || exit 1
	mkdir "$jobs/$id" || exit 1
	date +%s > "$jobs/$id/created"
	cat "$jobs/$id/created" > "$jobs/$id/stage_started"
	printf '%s\n' "$1" > "$jobs/$id/action"
	printf '%s\n' queued > "$jobs/$id/stage"
	if [ "$1" = settings-apply ] || [ "$1" = controls-apply ] || [ "$1" = enhance-save ]; then
		# RPC supplies a private file, never subscription JSON in argv or logs.
		case "$2" in /tmp/adzero-requests/*) ;; *) exit 1 ;; esac
		[ -f "$2" ] && [ ! -L "$2" ] || exit 1
		mv "$2" "$jobs/$id/input" || exit 1
		set -- "$1" "$jobs/$id/input"
	fi
	"$0" run "$id" "$@" </dev/null >"$jobs/$id/log" 2>&1 &
	printf '{"job":"%s"}\n' "$id"
	;;
 run)
	id=$2;shift 2
	printf '%s\n' "$id" | grep -Eq '^[a-f0-9-]{36}$' || exit 1
	[ -d "$jobs/$id" ] || exit 1
	export ADZERO_JOB_CONTEXT="$jobs/$id"
	printf '%s\n' "$$" > "$jobs/$id/worker"
	code=0
	"$ctl" "$@" || code=$?
	case "$1" in settings-apply|controls-apply|enhance-save) rm -f "$jobs/$id/input" ;; esac
	date +%s > "$jobs/$id/finished"
	[ -L "$jobs/$id/timeline" ] || printf '%s finished\n' "$(cat "$jobs/$id/finished")" >> "$jobs/$id/timeline"
	printf '%s\n' "$code" > "$jobs/$id/result.new" && mv "$jobs/$id/result.new" "$jobs/$id/result"
	;;
 *) exit 1 ;;
esac
